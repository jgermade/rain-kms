[Unit]
Description=rain-kms: full-screen digital rain kiosk (DRM/KMS)
Documentation=https://github.com/jgermade/rain-kms
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=kiosk
Group=kiosk
SupplementaryGroups=video
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/local/bin/rain-kms --layers 3 --max-size 40 --density 1 --speed-spread 4 --colors monokai
Restart=always
RestartSec=3

# Low priority: the rain is decorative, so under load it gives way to other
# services (it may drop a few frames while the machine is busy)
Nice=10
CPUWeight=20
IOSchedulingClass=idle

# Sandboxing: it only needs the graphics card and the font
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=64M

[Install]
WantedBy=multi-user.target
